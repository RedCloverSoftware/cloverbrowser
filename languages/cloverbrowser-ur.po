msgid "Path not found: %s"
msgstr "راستہ نہیں ملا: %s"

#: includes/class-cloverbrowser-trash.php:166
msgid "The trash folder could not be created. Check that the uploads folder is writable by PHP."
msgstr "ردی کی ٹوکری کا فولڈر نہیں بنایا جا سکا۔ تصدیق کریں کہ PHP اپ لوڈز فولڈر میں لکھ سکتا ہے۔"

#: includes/class-cloverbrowser-trash.php:421
msgid "The trash is turned off."
msgstr "ردی کی ٹوکری بند ہے۔"

#: includes/class-cloverbrowser-trash.php:453
msgid "This item could not be moved to the trash (it may be on another disk, or permissions do not allow it). Nothing was deleted."
msgstr "یہ آئٹم ردی کی ٹوکری میں منتقل نہیں ہو سکا (ہو سکتا ہے یہ کسی دوسری ڈسک پر ہو، یا اجازتیں اس کی اجازت نہ دیں)۔ کچھ بھی حذف نہیں ہوا۔"

#: includes/class-cloverbrowser-trash.php:464
msgid "The trash could not record this item, so it was left in place."
msgstr "ردی کی ٹوکری اس آئٹم کا اندراج نہیں کر سکی، اس لیے اسے اپنی جگہ پر چھوڑ دیا گیا۔"

#: includes/class-cloverbrowser-trash.php:574 includes/class-cloverbrowser-trash.php:611 includes/class-cloverbrowser-trash.php:737 includes/class-cloverbrowser-trash.php:785
msgid "This item is no longer in the trash."
msgstr "یہ آئٹم اب ردی کی ٹوکری میں نہیں ہے۔"

#: includes/class-cloverbrowser-trash.php:621
msgid "The stored copy of this item is missing."
msgstr "اس آئٹم کی محفوظ کاپی موجود نہیں۔"

#. translators: %s: path
#: includes/class-cloverbrowser-trash.php:646
msgid "Cannot restore: %s is no longer a folder."
msgstr "بحال نہیں کیا جا سکتا: %s اب فولڈر نہیں ہے۔"

#: includes/class-cloverbrowser-trash.php:663
msgid "Could not find a free name to restore this item under."
msgstr "اس آئٹم کو بحال کرنے کے لیے کوئی دستیاب نام نہیں ملا۔"

#. translators: %s: folder path
#: includes/class-cloverbrowser-trash.php:678
msgid "Could not recreate the folder %s."
msgstr "فولڈر %s دوبارہ نہیں بنایا جا سکا۔"

#: includes/class-cloverbrowser-trash.php:686
msgid "Restore failed (check permissions on the original folder)."
msgstr "بحالی ناکام رہی (اصل فولڈر کی اجازتیں چیک کریں)۔"

#: includes/class-cloverbrowser-trash.php:794
msgid "Some of this item could not be deleted (check permissions)."
msgstr "اس آئٹم کا کچھ حصہ حذف نہیں ہو سکا (اجازتیں چیک کریں)۔"

#. translators: Plugin header
#: cloverbrowser.php
msgid "Server file browser & editor for WordPress admins, sandboxed to this site's vhost root, with per-role access rules and a two-level trash. No public exposure."
msgstr "WordPress منتظمین کے لیے سرور فائل براؤزر اور ایڈیٹر، جو اس سائٹ کے ورچوئل ہوسٹ روٹ تک محدود ہے، کردار کے لحاظ سے رسائی کے قواعد اور دو سطحی ردی کی ٹوکری کے ساتھ۔ عوامی رسائی نہیں۔"
