msgstr "অনুমোদিত"

#: assets/js/access-rules.js:611
msgid "Test access"
msgstr "প্রবেশাধিকার পরীক্ষা"

#: assets/js/access-rules.js:612
msgid "Check what a role could do with a file or folder — using the rules on this screen, even before you save them."
msgstr "এই স্ক্রিনের নিয়ম ব্যবহার করে দেখুন কোনো ভূমিকা একটি ফাইল বা ফোল্ডারে কী করতে পারত — নিয়মগুলো সংরক্ষণের আগেই।"

#: assets/js/access-rules.js:616
msgid "Test"
msgstr "পরীক্ষা করুন"

#: assets/js/access-rules.js:631
msgid "Enter a number of days between 1 and 3650."
msgstr "1 থেকে 3650-এর মধ্যে দিনের সংখ্যা লিখুন।"

#: assets/js/access-rules.js:638
msgid "days"
msgstr "দিন"

#: assets/js/access-rules.js:649
msgid "Deleted files and folders can be kept for a while so they can be restored. There are two levels, and each can be switched on separately."
msgstr "মুছে ফেলা ফাইল ও ফোল্ডার কিছু সময় রেখে দেওয়া যায়, যাতে সেগুলো ফিরিয়ে আনা যায়। এর দুটি স্তর আছে, এবং প্রতিটি আলাদাভাবে চালু করা যায়।"

#: assets/js/access-rules.js:653
msgid "Personal trash"
msgstr "ব্যক্তিগত ট্র্যাশ"

#: assets/js/access-rules.js:655
msgid "Give every user their own trash"
msgstr "প্রত্যেক ব্যবহারকারীকে নিজস্ব ট্র্যাশ দিন"

#: assets/js/access-rules.js:656
msgid "Each user’s deletions go to their own Trash, where they can restore them, remove them or empty it. They only ever see their own items."
msgstr "প্রত্যেক ব্যবহারকারীর মোছা আইটেম তাঁর নিজস্ব ট্র্যাশে যায়, যেখানে তিনি সেগুলো ফিরিয়ে আনতে, সরাতে বা ট্র্যাশ খালি করতে পারেন। তাঁরা শুধু নিজের আইটেমই দেখতে পান।"

#: assets/js/access-rules.js:657
msgid "Keep items in a user’s trash for"
msgstr "ব্যবহারকারীর ট্র্যাশে আইটেম রাখার সময়কাল"

#: assets/js/access-rules.js:659 assets/js/file-browser.js:214 assets/js/file-browser.js:1971
msgid "Site trash"
msgstr "সাইট ট্র্যাশ"

#: assets/js/access-rules.js:661
msgid "Keep every deletion in the site trash"
msgstr "প্রতিটি মোছা আইটেম সাইট ট্র্যাশে রাখুন"

#: assets/js/access-rules.js:662
msgid "A safety net for administrators: everything any user deletes is kept here, even after they empty their own trash. Only administrators can see it, restore from it or empty it."
msgstr "অ্যাডমিনিস্ট্রেটরদের জন্য একটি সুরক্ষা-বলয়: যেকোনো ব্যবহারকারী যা কিছু মোছেন, তা এখানে রাখা হয়, এমনকি তাঁরা নিজের ট্র্যাশ খালি করার পরেও। শুধু অ্যাডমিনিস্ট্রেটররাই এটি দেখতে, এখান থেকে ফিরিয়ে আনতে বা এটি খালি করতে পারেন।"

#: assets/js/access-rules.js:663
msgid "Keep items in the site trash for"
msgstr "সাইট ট্র্যাশে আইটেম রাখার সময়কাল"

#: assets/js/access-rules.js:669
msgid "Recommended"
msgstr "প্রস্তাবিত"

#: assets/js/access-rules.js:672 assets/js/access-rules.js:674
msgid "Permanent deletion"
msgstr "স্থায়ীভাবে মোছা"

#: assets/js/access-rules.js:673
msgid "Who may delete an item for good before the site trash’s retention period is over."
msgstr "সাইট ট্র্যাশের সংরক্ষণকাল শেষ হওয়ার আগে কে একটি আইটেম স্থায়ীভাবে মুছতে পারবেন।"

#: assets/js/access-rules.js:675
msgid "Administrators only"
msgstr "শুধু অ্যাডমিনিস্ট্রেটর"

#: assets/js/access-rules.js:676
msgid "Users can remove items from their own trash, but the site trash keeps its copy until it expires."
msgstr "ব্যবহারকারীরা নিজের ট্র্যাশ থেকে আইটেম সরাতে পারেন, কিন্তু মেয়াদ শেষ না হওয়া পর্যন্ত সাইট ট্র্যাশে এর কপি থেকে যায়।"

#: assets/js/access-rules.js:677
msgid "Also the user who deleted the item"
msgstr "যে ব্যবহারকারী আইটেমটি মুছেছেন, তিনিও"

#: assets/js/access-rules.js:678
msgid "In their own trash, a user can right-click an item and choose “Permanently delete”, which also removes it from the site trash. They can never empty the site trash."
msgstr "নিজের ট্র্যাশে একজন ব্যবহারকারী কোনো আইটেমে রাইট-ক্লিক করে “স্থায়ীভাবে মুছুন” বেছে নিতে পারেন, যা এটিকে সাইট ট্র্যাশ থেকেও সরিয়ে দেয়। তাঁরা কখনো সাইট ট্র্যাশ খালি করতে পারেন না।"

#: assets/js/access-rules.js:679
msgid "Requires the personal trash: users can only reach this option from their own trash."
msgstr "ব্যক্তিগত ট্র্যাশ চালু থাকা প্রয়োজন: ব্যবহারকারীরা শুধু নিজের ট্র্যাশ থেকেই এই বিকল্পে পৌঁছাতে পারেন।"

#: assets/js/access-rules.js:683
msgid "Stored in:"
msgstr "সংরক্ষিত আছে:"

#: assets/js/access-rules.js:684
msgid "The trash folder is created on the first deletion."
msgstr "প্রথমবার কিছু মোছার সময় ট্র্যাশ ফোল্ডার তৈরি হয়।"

#: assets/js/access-rules.js:686
msgid "Outside the public web root: the web server cannot serve these files."
