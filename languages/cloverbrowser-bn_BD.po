#: cloverbrowser.php:214
msgid "You do not have permission to access the file browser."
msgstr "ফাইল ব্রাউজারে প্রবেশের অনুমতি আপনার নেই।"

#. translators: %s: absolute server path of the sandbox root
#: cloverbrowser.php:227
msgid "Full file access for this server, sandboxed to %s."
msgstr "এই সার্ভারের ফাইলে পূর্ণ প্রবেশাধিকার, %s-এর মধ্যে সীমাবদ্ধ।"

#: cloverbrowser.php:233
msgid "Admin-only; every request is capability- and nonce-checked."
msgstr "শুধু অ্যাডমিনদের জন্য; প্রতিটি অনুরোধে অনুমতি ও nonce যাচাই করা হয়।"

#: cloverbrowser.php:235 assets/js/file-browser.js:161
msgid "Your access is limited by rules set by an administrator."
msgstr "আপনার প্রবেশাধিকার একজন অ্যাডমিনিস্ট্রেটরের নির্ধারিত নিয়মে সীমাবদ্ধ।"

#: cloverbrowser.php:240
msgid "Read-only mode."
msgstr "শুধু-পঠন মোড।"

#: cloverbrowser.php:243
msgid "Loading file browser…"
msgstr "ফাইল ব্রাউজার লোড হচ্ছে…"

#: cloverbrowser.php:244 cloverbrowser.php:259
msgid "The file browser requires JavaScript."
msgstr "ফাইল ব্রাউজারের জন্য JavaScript প্রয়োজন।"

#: cloverbrowser.php:252 includes/class-cloverbrowser-ajax.php:120
msgid "Only administrators can manage access rules."
msgstr "শুধু অ্যাডমিনিস্ট্রেটররাই প্রবেশাধিকারের নিয়ম পরিচালনা করতে পারেন।"

#: cloverbrowser.php:258
msgid "Loading settings…"
msgstr "সেটিংস লোড হচ্ছে…"

#: assets/js/access-rules.js:76 assets/js/file-browser.js:375
msgid "Network error — the server may be busy or unreachable."
msgstr "নেটওয়ার্ক ত্রুটি — সার্ভার ব্যস্ত বা নাগালের বাইরে থাকতে পারে।"

#. translators: %d: HTTP status code
#: assets/js/access-rules.js:83 assets/js/file-browser.js:382
msgid "Unexpected server response (HTTP %d)."
msgstr "সার্ভারের অপ্রত্যাশিত প্রতিক্রিয়া (HTTP %d)।"

#: assets/js/access-rules.js:85 assets/js/file-browser.js:385
msgid "Request failed."
msgstr "অনুরোধ ব্যর্থ হয়েছে।"

#: assets/js/access-rules.js:139
msgid "Open files"
msgstr "ফাইল খোলা"

#: assets/js/access-rules.js:139
msgid "Read file contents in the viewer. Folders can always be browsed once access is enabled."
msgstr "ভিউয়ারে ফাইলের বিষয়বস্তু পড়া। প্রবেশাধিকার চালু থাকলে ফোল্ডার সবসময় ব্রাউজ করা যায়।"

#: assets/js/access-rules.js:140
msgid "Download files"
msgstr "ফাইল ডাউনলোড"

#: assets/js/access-rules.js:140
msgid "Save copies of files to their computer."
msgstr "ফাইলের কপি নিজের কম্পিউটারে সংরক্ষণ করা।"

#: assets/js/access-rules.js:141
msgid "Edit & save files"
msgstr "ফাইল সম্পাদনা ও সংরক্ষণ"

#: assets/js/access-rules.js:141
msgid "Change file contents in the editor (includes autosaved drafts and line-ending conversion)."
msgstr "এডিটরে ফাইলের বিষয়বস্তু পরিবর্তন করা (স্বয়ংক্রিয়ভাবে সংরক্ষিত খসড়া ও লাইন এন্ডিং রূপান্তরসহ)।"

#: assets/js/access-rules.js:142
msgid "Create files & folders"
msgstr "ফাইল ও ফোল্ডার তৈরি"

#: assets/js/access-rules.js:142
msgid "Make new empty files and folders."
msgstr "নতুন খালি ফাইল ও ফোল্ডার তৈরি করা।"

#: assets/js/access-rules.js:143
msgid "Upload files"
msgstr "ফাইল আপলোড"

#: assets/js/access-rules.js:143
msgid "Add files from their computer, and replace existing ones they may edit."
msgstr "নিজের কম্পিউটার থেকে ফাইল যোগ করা এবং সম্পাদনার অনুমতি আছে এমন বিদ্যমান ফাইল প্রতিস্থাপন করা।"

#: assets/js/access-rules.js:144 assets/js/access-rules.js:578
msgid "Rename & move"
msgstr "নাম পরিবর্তন ও সরানো"

#: assets/js/access-rules.js:144
msgid "Rename files and folders within the folders they can access."
msgstr "প্রবেশাধিকার আছে এমন ফোল্ডারের মধ্যে ফাইল ও ফোল্ডারের নাম পরিবর্তন করা।"

#: assets/js/access-rules.js:145 assets/js/access-rules.js:578 assets/js/file-browser.js:767 assets/js/file-browser.js:1628
msgid "Delete"
msgstr "মুছুন"

#: assets/js/access-rules.js:145
msgid "Remove files and folders, including everything inside a folder."
msgstr "ফাইল ও ফোল্ডার মুছে ফেলা, ফোল্ডারের ভেতরের সবকিছুসহ।"

#: assets/js/access-rules.js:146 assets/js/access-rules.js:578 assets/js/file-browser.js:765
msgid "Change permissions"
msgstr "অনুমতি পরিবর্তন করুন"

#: assets/js/access-rules.js:146
msgid "Change Unix file modes (chmod). Rarely needed — keep off unless required."
msgstr "ফাইলের Unix মোড পরিবর্তন করা (chmod)। কদাচিৎ দরকার হয় — প্রয়োজন না হলে বন্ধ রাখুন।"

#: assets/js/access-rules.js:149
msgid "PHP files and any file containing PHP tags — even hidden inside an image. Anyone who can write PHP can take over the site."
msgstr "PHP ফাইল এবং PHP ট্যাগ আছে এমন যেকোনো ফাইল — এমনকি ছবির ভেতরে লুকানো থাকলেও। যে PHP লিখতে পারে, সে সাইটের নিয়ন্ত্রণ নিতে পারে।"

#: assets/js/access-rules.js:150
msgid ".htaccess, .user.ini, php.ini, web.config and .env files — they change how the server runs code or hold secrets."
msgstr ".htaccess, .user.ini, php.ini, web.config ও .env ফাইল — এগুলো সার্ভার কীভাবে কোড চালায় তা বদলায় বা গোপন তথ্য ধারণ করে।"

#: assets/js/access-rules.js:151
msgid "Programs and scripts: binary executables, shell/Python/Perl scripts and anything starting with “#!”."
msgstr "প্রোগ্রাম ও স্ক্রিপ্ট: বাইনারি এক্সিকিউটেবল, shell/Python/Perl স্ক্রিপ্ট এবং “#!” দিয়ে শুরু হওয়া যেকোনো কিছু।"

#: assets/js/access-rules.js:152
msgid "HTML, SVG, JavaScript and XML — they can run scripts in visitors’ browsers."
msgstr "HTML, SVG, JavaScript ও XML — এগুলো দর্শকদের ব্রাউজারে স্ক্রিপ্ট চালাতে পারে।"

#: assets/js/access-rules.js:153
msgid "ZIP, GZIP, TAR, 7-Zip, RAR and similar archives."
msgstr "ZIP, GZIP, TAR, 7-Zip, RAR ও অনুরূপ আর্কাইভ।"

#: assets/js/access-rules.js:154
msgid "JPEG, PNG, GIF, WebP, AVIF, TIFF and other images."
msgstr "JPEG, PNG, GIF, WebP, AVIF, TIFF ও অন্যান্য ছবি।"

#: assets/js/access-rules.js:155
msgid "MP3, MP4, WebM, WAV, OGG and other audio and video."
msgstr "MP3, MP4, WebM, WAV, OGG ও অন্যান্য অডিও ও ভিডিও।"

#: assets/js/access-rules.js:156
msgid "PDF, Word, Excel, PowerPoint, OpenDocument and RTF."
msgstr "PDF, Word, Excel, PowerPoint, OpenDocument ও RTF।"

#: assets/js/access-rules.js:157
msgid "SQLite databases, SQL dumps and .bak backups — they often contain passwords."
msgstr "SQLite ডেটাবেস, SQL ডাম্প ও .bak ব্যাকআপ — এগুলোতে প্রায়ই পাসওয়ার্ড থাকে।"

#: assets/js/access-rules.js:158
msgid "Anything that is not plain text and not covered above."
msgstr "সাধারণ টেক্সট নয় এবং উপরে উল্লেখ নেই এমন যেকোনো কিছু।"

#: assets/js/access-rules.js:161
msgid "Name contains"
msgstr "নামে আছে"

#: assets/js/access-rules.js:161
msgid "secret"
msgstr "secret"

#: assets/js/access-rules.js:161
msgid "Any file or folder whose name contains this text, in any folder. Not case-sensitive."
msgstr "যেকোনো ফোল্ডারে থাকা যেকোনো ফাইল বা ফোল্ডার, যার নামে এই লেখা আছে। বড়/ছোট হাতের অক্ষরে পার্থক্য করে না।"

#: assets/js/access-rules.js:162
msgid "Name matches"
msgstr "নাম মেলে"

#: assets/js/access-rules.js:162
msgid "A name pattern: * matches any characters, ? matches one. Example: *.bak or wp-config*."
msgstr "নামের প্যাটার্ন: * যেকোনো অক্ষরের সঙ্গে মেলে, ? একটি অক্ষরের সঙ্গে। উদাহরণ: *.bak বা wp-config*।"

#: assets/js/access-rules.js:163
msgid "Exact path"
msgstr "নির্দিষ্ট পাথ"

#: assets/js/access-rules.js:163
msgid "One specific file or folder, relative to the site root."
msgstr "সাইটের রুট থেকে আপেক্ষিক একটি নির্দিষ্ট ফাইল বা ফোল্ডার।"

#: assets/js/access-rules.js:164
msgid "Folder and contents"
msgstr "ফোল্ডার ও বিষয়বস্তু"

#: assets/js/access-rules.js:164
msgid "A folder and everything inside it, relative to the site root."
msgstr "সাইটের রুট থেকে আপেক্ষিক একটি ফোল্ডার ও তার ভেতরের সবকিছু।"

#: assets/js/access-rules.js:167
msgid "Hidden & blocked"
msgstr "লুকানো ও ব্লক করা"

#: assets/js/access-rules.js:168 assets/js/access-rules.js:331 assets/js/file-browser.js:162
msgid "Read-only"
msgstr "শুধু-পঠন"

#: assets/js/access-rules.js:223
msgid "Folders"
msgstr "ফোল্ডার"

#: assets/js/access-rules.js:226 assets/js/file-browser.js:1949
msgid "Loading…"
msgstr "লোড হচ্ছে…"

#: assets/js/access-rules.js:249
msgid "No subfolders."
msgstr "কোনো সাবফোল্ডার নেই।"

#: assets/js/access-rules.js:255
msgid "Selected folder:"
msgstr "নির্বাচিত ফোল্ডার:"

#: assets/js/access-rules.js:256
msgid "Choose a folder"
msgstr "একটি ফোল্ডার বেছে নিন"

#: assets/js/access-rules.js:257 assets/js/access-rules.js:771 assets/js/file-browser.js:527 assets/js/file-browser.js:552 assets/js/file-browser.js:933 assets/js/file-browser.js:1342 assets/js/file-browser.js:1481 assets/js/file-browser.js:1627 assets/js/file-browser.js:2291
msgid "Cancel"
msgstr "বাতিল"

#: assets/js/access-rules.js:258
msgid "Use this folder"
msgstr "এই ফোল্ডারটি ব্যবহার করুন"

#: assets/js/access-rules.js:268
msgid "Save changes"
msgstr "পরিবর্তন সংরক্ষণ করুন"

#: assets/js/access-rules.js:269 assets/js/access-rules.js:772
msgid "Discard"
msgstr "বাদ দিন"

#: assets/js/access-rules.js:270 assets/js/file-browser.js:926
msgid "Unsaved changes"
msgstr "অসংরক্ষিত পরিবর্তন"

#: assets/js/access-rules.js:271 assets/js/access-rules.js:344
msgid "Roles"
msgstr "ভূমিকা"

#: assets/js/access-rules.js:290
msgid "Access rules"
msgstr "প্রবেশাধিকারের নিয়ম"

#: assets/js/access-rules.js:290 assets/js/access-rules.js:648 assets/js/file-browser.js:163 assets/js/file-browser.js:212 assets/js/file-browser.js:1915 assets/js/file-browser.js:1971
msgid "Trash"
msgstr "ট্র্যাশ"

#: assets/js/access-rules.js:293
msgid "Administrators always have full access and are not affected by these rules. Every other role has no access until you enable it."
msgstr "অ্যাডমিনিস্ট্রেটরদের সবসময় পূর্ণ প্রবেশাধিকার থাকে এবং এই নিয়ম তাঁদের ওপর প্রযোজ্য নয়। অন্য কোনো ভূমিকার প্রবেশাধিকার থাকে না, যতক্ষণ না আপনি তা চালু করেন।"

#: assets/js/access-rules.js:294
msgid "The “All roles” rules apply to every enabled role. A role’s own rules can only add restrictions on top of them."
msgstr "“সব ভূমিকা”-র নিয়ম প্রতিটি চালু করা ভূমিকায় প্রযোজ্য। কোনো ভূমিকার নিজস্ব নিয়ম এর ওপর কেবল আরও বিধিনিষেধ যোগ করতে পারে।"

#: assets/js/access-rules.js:295
msgid "File editing is disabled for this site (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY), so every role is read-only whatever you allow here."
msgstr "এই সাইটে ফাইল সম্পাদনা নিষ্ক্রিয় (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY), তাই এখানে যা-ই অনুমতি দিন, প্রতিটি ভূমিকা শুধু-পঠন থাকবে।"

#: assets/js/access-rules.js:326
msgid "No access"
msgstr "প্রবেশাধিকার নেই"

#: assets/js/access-rules.js:330
msgid "Browse only"
msgstr "শুধু ব্রাউজ"

#: assets/js/access-rules.js:332
msgid "Full"
msgstr "পূর্ণ"

#: assets/js/access-rules.js:333
msgid "Custom"
msgstr "কাস্টম"

#: assets/js/access-rules.js:343 assets/js/access-rules.js:396 includes/class-cloverbrowser-policy.php:111
msgid "All roles"
msgstr "সব ভূমিকা"

#: assets/js/access-rules.js:343
msgid "Applies to every enabled role"
msgstr "প্রতিটি চালু করা ভূমিকায় প্রযোজ্য"

#. translators: %s: number of users
#: assets/js/access-rules.js:349
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s জন ব্যবহারকারী"
msgstr[1] "%s জন ব্যবহারকারী"

#: assets/js/access-rules.js:351
msgid "Administrators are not listed: they always have full access."
msgstr "অ্যাডমিনিস্ট্রেটরদের তালিকায় দেখানো হয় না: তাঁদের সবসময় পূর্ণ প্রবেশাধিকার থাকে।"

#. translators: %s: role name
#: assets/js/access-rules.js:367 includes/class-cloverbrowser-policy.php:134
msgid "%s can create or modify PHP code. Anyone who can write PHP can take over the whole site — block the “PHP code” type unless that is intended."
msgstr "%s PHP কোড তৈরি বা পরিবর্তন করতে পারে। যে PHP লিখতে পারে, সে পুরো সাইটের নিয়ন্ত্রণ নিতে পারে — ইচ্ছাকৃত না হলে “PHP কোড” ধরনটি ব্লক করুন।"

#. translators: %s: role name
#: assets/js/access-rules.js:372 includes/class-cloverbrowser-policy.php:127
msgid "%s is normally given to untrusted accounts. Make sure you really want it to reach server files."
msgstr "%s সাধারণত অবিশ্বস্ত অ্যাকাউন্টকে দেওয়া হয়। নিশ্চিত হোন যে আপনি সত্যিই এটিকে সার্ভারের ফাইলে প্রবেশাধিকার দিতে চান।"

#: assets/js/access-rules.js:398
msgid "Baseline rules for every non-administrator role that has access. Roles can be restricted further on their own pages."
msgstr "প্রবেশাধিকার আছে এমন প্রতিটি অ্যাডমিনিস্ট্রেটর নয় এমন ভূমিকার মৌলিক নিয়ম। প্রতিটি ভূমিকার নিজস্ব পাতায় আরও সীমাবদ্ধ করা যায়।"

#: assets/js/access-rules.js:399
msgid "Rules for this role. They add to the “All roles” rules — they can never grant more than those allow."
msgstr "এই ভূমিকার নিয়ম। এগুলো “সব ভূমিকা”-র নিয়মের সঙ্গে যুক্ত হয় — সেগুলো যতটা অনুমতি দেয়, তার বেশি কখনো দিতে পারে না।"

#: assets/js/access-rules.js:403
msgid "Access"
msgstr "প্রবেশাধিকার"

#. translators: %s: role name
#: assets/js/access-rules.js:407
msgid "Allow %s users to use Cloverbrowser"
