msgid "Effect"
msgstr "প্রভাব"

#: assets/js/access-rules.js:502
msgid "Built in: always protected from non-administrators."
msgstr "অন্তর্নির্মিত: অ্যাডমিনিস্ট্রেটর নন এমন সবার কাছ থেকে সবসময় সুরক্ষিত।"

#: assets/js/access-rules.js:502
msgid "Always"
msgstr "সবসময়"

#. translators: %s: number of rules
#: assets/js/access-rules.js:506
msgid "Plus %s rule from “All roles” and the built-in protections."
msgid_plural "Plus %s rules from “All roles” and the built-in protections."
msgstr[0] "এছাড়াও “সব ভূমিকা” থেকে %sটি নিয়ম এবং অন্তর্নির্মিত সুরক্ষা।"
msgstr[1] "এছাড়াও “সব ভূমিকা” থেকে %sটি নিয়ম এবং অন্তর্নির্মিত সুরক্ষা।"

#: assets/js/access-rules.js:507
msgid "Plus the built-in protections."
msgstr "এছাড়াও অন্তর্নির্মিত সুরক্ষা।"

#: assets/js/access-rules.js:516
msgid "Required."
msgstr "আবশ্যক।"

#: assets/js/access-rules.js:517
msgid "Name rules match a single name — use “Exact path” or “Folder and contents” for paths."
msgstr "নামের নিয়ম একটি মাত্র নামের সঙ্গে মেলে — পাথের জন্য “নির্দিষ্ট পাথ” বা “ফোল্ডার ও বিষয়বস্তু” ব্যবহার করুন।"

