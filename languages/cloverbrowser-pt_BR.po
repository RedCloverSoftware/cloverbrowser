msgstr "A solicitação falhou."

#: assets/js/access-rules.js:139
msgid "Open files"
msgstr "Abrir arquivos"

#: assets/js/access-rules.js:139
msgid "Read file contents in the viewer. Folders can always be browsed once access is enabled."
msgstr "Ler o conteúdo dos arquivos no visualizador. As pastas sempre podem ser navegadas depois que o acesso é ativado."

#: assets/js/access-rules.js:140
msgid "Download files"
msgstr "Baixar arquivos"

#: assets/js/access-rules.js:140
msgid "Save copies of files to their computer."
msgstr "Salvar cópias dos arquivos no computador."

#: assets/js/access-rules.js:141
msgid "Edit & save files"
msgstr "Editar e salvar arquivos"

#: assets/js/access-rules.js:141
msgid "Change file contents in the editor (includes autosaved drafts and line-ending conversion)."
msgstr "Alterar o conteúdo dos arquivos no editor (inclui rascunhos automáticos e conversão de quebras de linha)."

#: assets/js/access-rules.js:142
msgid "Create files & folders"
msgstr "Criar arquivos e pastas"

#: assets/js/access-rules.js:142
msgid "Make new empty files and folders."
msgstr "Criar novos arquivos e pastas vazios."

#: assets/js/access-rules.js:143
msgid "Upload files"
msgstr "Enviar arquivos"

#: assets/js/access-rules.js:143
msgid "Add files from their computer, and replace existing ones they may edit."
msgstr "Adicionar arquivos do computador e substituir os existentes que podem editar."

#: assets/js/access-rules.js:144 assets/js/access-rules.js:578
msgid "Rename & move"
msgstr "Renomear e mover"

#: assets/js/access-rules.js:144
msgid "Rename files and folders within the folders they can access."
msgstr "Renomear arquivos e pastas dentro das pastas que podem acessar."

#: assets/js/access-rules.js:145 assets/js/access-rules.js:578 assets/js/file-browser.js:767 assets/js/file-browser.js:1628
msgid "Delete"
msgstr "Excluir"

#: assets/js/access-rules.js:145
msgid "Remove files and folders, including everything inside a folder."
msgstr "Remover arquivos e pastas, incluindo todo o conteúdo de uma pasta."

#: assets/js/access-rules.js:146 assets/js/access-rules.js:578 assets/js/file-browser.js:765
msgid "Change permissions"
msgstr "Alterar permissões"

#: assets/js/access-rules.js:146
msgid "Change Unix file modes (chmod). Rarely needed — keep off unless required."
msgstr "Alterar as permissões Unix dos arquivos (chmod). Raramente necessário — mantenha desativado, a menos que precise."

#: assets/js/access-rules.js:149
msgid "PHP files and any file containing PHP tags — even hidden inside an image. Anyone who can write PHP can take over the site."
msgstr "Arquivos PHP e qualquer arquivo com tags PHP — mesmo escondidas dentro de uma imagem. Quem pode escrever PHP pode assumir o controle do site."

#: assets/js/access-rules.js:150
msgid ".htaccess, .user.ini, php.ini, web.config and .env files — they change how the server runs code or hold secrets."
msgstr "Arquivos .htaccess, .user.ini, php.ini, web.config e .env — alteram como o servidor executa código ou guardam segredos."

#: assets/js/access-rules.js:151
msgid "Programs and scripts: binary executables, shell/Python/Perl scripts and anything starting with “#!”."
msgstr "Programas e scripts: executáveis binários, scripts shell/Python/Perl e qualquer coisa que comece com “#!”."

#: assets/js/access-rules.js:152
msgid "HTML, SVG, JavaScript and XML — they can run scripts in visitors’ browsers."
msgstr "HTML, SVG, JavaScript e XML — podem executar scripts no navegador dos visitantes."

#: assets/js/access-rules.js:153
msgid "ZIP, GZIP, TAR, 7-Zip, RAR and similar archives."
msgstr "ZIP, GZIP, TAR, 7-Zip, RAR e arquivos compactados semelhantes."

#: assets/js/access-rules.js:154
msgid "JPEG, PNG, GIF, WebP, AVIF, TIFF and other images."
msgstr "JPEG, PNG, GIF, WebP, AVIF, TIFF e outras imagens."

#: assets/js/access-rules.js:155
msgid "MP3, MP4, WebM, WAV, OGG and other audio and video."
msgstr "MP3, MP4, WebM, WAV, OGG e outros arquivos de áudio e vídeo."

#: assets/js/access-rules.js:156
msgid "PDF, Word, Excel, PowerPoint, OpenDocument and RTF."
msgstr "PDF, Word, Excel, PowerPoint, OpenDocument e RTF."

#: assets/js/access-rules.js:157
msgid "SQLite databases, SQL dumps and .bak backups — they often contain passwords."
msgstr "Bancos de dados SQLite, dumps SQL e backups .bak — costumam conter senhas."

#: assets/js/access-rules.js:158
msgid "Anything that is not plain text and not covered above."
msgstr "Qualquer coisa que não seja texto simples e não esteja incluída acima."

#: assets/js/access-rules.js:161
msgid "Name contains"
msgstr "O nome contém"

#: assets/js/access-rules.js:161
msgid "secret"
msgstr "secreto"

#: assets/js/access-rules.js:161
msgid "Any file or folder whose name contains this text, in any folder. Not case-sensitive."
msgstr "Qualquer arquivo ou pasta cujo nome contenha este texto, em qualquer pasta. Não diferencia maiúsculas de minúsculas."

#: assets/js/access-rules.js:162
msgid "Name matches"
msgstr "O nome corresponde a"

#: assets/js/access-rules.js:162
msgid "A name pattern: * matches any characters, ? matches one. Example: *.bak or wp-config*."
msgstr "Um padrão de nome: * corresponde a quaisquer caracteres e ? a um só. Exemplo: *.bak ou wp-config*."

#: assets/js/access-rules.js:163
msgid "Exact path"
msgstr "Caminho exato"

#: assets/js/access-rules.js:163
msgid "One specific file or folder, relative to the site root."
msgstr "Um arquivo ou pasta específico, relativo à raiz do site."

#: assets/js/access-rules.js:164
msgid "Folder and contents"
msgstr "Pasta e conteúdo"

#: assets/js/access-rules.js:164
msgid "A folder and everything inside it, relative to the site root."
msgstr "Uma pasta e tudo o que há nela, relativa à raiz do site."

