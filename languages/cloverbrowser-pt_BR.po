msgstr "Função"

#: assets/js/access-rules.js:582
msgid "Path to test"
msgstr "Caminho a testar"

#: assets/js/access-rules.js:587
msgid "Checking…"
msgstr "Verificando…"

#: assets/js/access-rules.js:592
