msgid "Access rules"
msgstr "Regras de acesso"

#: assets/js/access-rules.js:290 assets/js/access-rules.js:648 assets/js/file-browser.js:163 assets/js/file-browser.js:212 assets/js/file-browser.js:1915 assets/js/file-browser.js:1971
msgid "Trash"
msgstr "Lixeira"

#: assets/js/access-rules.js:293
msgid "Administrators always have full access and are not affected by these rules. Every other role has no access until you enable it."
msgstr "Administradores sempre têm acesso total e não são afetados por estas regras. Nenhuma outra função tem acesso até que você o ative."

#: assets/js/access-rules.js:294
msgid "The “All roles” rules apply to every enabled role. A role’s own rules can only add restrictions on top of them."
msgstr "As regras de “Todas as funções” valem para toda função ativada. As regras próprias de uma função só podem acrescentar restrições."

#: assets/js/access-rules.js:295
msgid "File editing is disabled for this site (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY), so every role is read-only whatever you allow here."
msgstr "A edição de arquivos está desativada neste site (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY), então todas as funções ficam somente leitura, independentemente do que você permitir aqui."

#: assets/js/access-rules.js:326
msgid "No access"
msgstr "Sem acesso"

#: assets/js/access-rules.js:330
msgid "Browse only"
msgstr "Só navegar"

#: assets/js/access-rules.js:332
msgid "Full"
msgstr "Total"

#: assets/js/access-rules.js:333
msgid "Custom"
msgstr "Personalizado"

#: assets/js/access-rules.js:343 assets/js/access-rules.js:396 includes/class-cloverbrowser-policy.php:111
msgid "All roles"
msgstr "Todas as funções"

#: assets/js/access-rules.js:343
msgid "Applies to every enabled role"
msgstr "Vale para toda função ativada"

#. translators: %s: number of users
#: assets/js/access-rules.js:349
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s usuário"
msgstr[1] "%s usuários"

#: assets/js/access-rules.js:351
msgid "Administrators are not listed: they always have full access."
msgstr "Administradores não aparecem na lista: eles sempre têm acesso total."

#. translators: %s: role name
#: assets/js/access-rules.js:367 includes/class-cloverbrowser-policy.php:134
msgid "%s can create or modify PHP code. Anyone who can write PHP can take over the whole site — block the “PHP code” type unless that is intended."
msgstr "%s pode criar ou modificar código PHP. Quem pode escrever PHP pode assumir o controle de todo o site — bloqueie o tipo “Código PHP”, a menos que seja intencional."

#. translators: %s: role name
#: assets/js/access-rules.js:372 includes/class-cloverbrowser-policy.php:127
msgid "%s is normally given to untrusted accounts. Make sure you really want it to reach server files."
msgstr "%s normalmente é atribuída a contas não confiáveis. Confirme que você realmente quer que ela acesse arquivos do servidor."

#: assets/js/access-rules.js:398
msgid "Baseline rules for every non-administrator role that has access. Roles can be restricted further on their own pages."
msgstr "Regras básicas para toda função não administradora com acesso. Cada função pode ser restringida ainda mais na própria página."

#: assets/js/access-rules.js:399
msgid "Rules for this role. They add to the “All roles” rules — they can never grant more than those allow."
msgstr "Regras desta função. Elas se somam às de “Todas as funções” — nunca podem conceder mais do que aquelas permitem."

#: assets/js/access-rules.js:403
msgid "Access"
msgstr "Acesso"

#. translators: %s: role name
#: assets/js/access-rules.js:407
msgid "Allow %s users to use Cloverbrowser"
msgstr "Permitir que usuários com a função %s usem o Cloverbrowser"

#: assets/js/access-rules.js:408
msgid "When off, users with this role do not see Cloverbrowser at all."
msgstr "Quando desativado, usuários com esta função não veem o Cloverbrowser."

#: assets/js/access-rules.js:412
msgid "Access is off — you can still prepare these rules; they apply once access is enabled."
msgstr "O acesso está desativado — você ainda pode preparar estas regras; elas valerão quando o acesso for ativado."

#: assets/js/access-rules.js:417
msgid "View only"
msgstr "Só visualizar"

#: assets/js/access-rules.js:418
msgid "View & download"
msgstr "Visualizar e baixar"

#: assets/js/access-rules.js:419
