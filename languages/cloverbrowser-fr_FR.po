#: cloverbrowser.php:38
msgid "Cloverbrowser requires PHP 8.0 or newer."
msgstr "Cloverbrowser nécessite PHP 8.0 ou une version plus récente."

#: cloverbrowser.php:94
msgid "Browse files"
msgstr "Parcourir les fichiers"

#: cloverbrowser.php:97 cloverbrowser.php:98 cloverbrowser.php:112 cloverbrowser.php:256 assets/js/access-rules.js:302 assets/js/access-rules.js:303 assets/js/file-browser.js:164
msgid "Settings"
msgstr "Réglages"

#: cloverbrowser.php:214
msgid "You do not have permission to access the file browser."
msgstr "Vous n’avez pas l’autorisation d’accéder à l’explorateur de fichiers."

#. translators: %s: absolute server path of the sandbox root
#: cloverbrowser.php:227
msgid "Full file access for this server, sandboxed to %s."
msgstr "Accès complet aux fichiers de ce serveur, limité à %s."

#: cloverbrowser.php:233
msgid "Admin-only; every request is capability- and nonce-checked."
msgstr "Réservé aux administrateurs ; chaque requête vérifie les droits et le nonce."

#: cloverbrowser.php:235 assets/js/file-browser.js:161
msgid "Your access is limited by rules set by an administrator."
msgstr "Votre accès est limité par des règles définies par un administrateur."

#: cloverbrowser.php:240
msgid "Read-only mode."
msgstr "Mode lecture seule."

#: cloverbrowser.php:243
msgid "Loading file browser…"
msgstr "Chargement de l’explorateur de fichiers…"

#: cloverbrowser.php:244 cloverbrowser.php:259
msgid "The file browser requires JavaScript."
msgstr "L’explorateur de fichiers nécessite JavaScript."

#: cloverbrowser.php:252 includes/class-cloverbrowser-ajax.php:120
msgid "Only administrators can manage access rules."
msgstr "Seuls les administrateurs peuvent gérer les règles d’accès."

#: cloverbrowser.php:258
msgid "Loading settings…"
msgstr "Chargement des réglages…"

#: assets/js/access-rules.js:76 assets/js/file-browser.js:375
msgid "Network error — the server may be busy or unreachable."
msgstr "Erreur réseau : le serveur est peut-être occupé ou injoignable."

#. translators: %d: HTTP status code
#: assets/js/access-rules.js:83 assets/js/file-browser.js:382
msgid "Unexpected server response (HTTP %d)."
msgstr "Réponse inattendue du serveur (HTTP %d)."

#: assets/js/access-rules.js:85 assets/js/file-browser.js:385
msgid "Request failed."
msgstr "La requête a échoué."

#: assets/js/access-rules.js:139
msgid "Open files"
msgstr "Ouvrir les fichiers"

#: assets/js/access-rules.js:139
msgid "Read file contents in the viewer. Folders can always be browsed once access is enabled."
msgstr "Lire le contenu des fichiers dans la visionneuse. Les dossiers restent toujours consultables une fois l’accès activé."

#: assets/js/access-rules.js:140
msgid "Download files"
msgstr "Télécharger les fichiers"

#: assets/js/access-rules.js:140
msgid "Save copies of files to their computer."
msgstr "Enregistrer des copies des fichiers sur leur ordinateur."

#: assets/js/access-rules.js:141
msgid "Edit & save files"
msgstr "Modifier et enregistrer"

#: assets/js/access-rules.js:141
msgid "Change file contents in the editor (includes autosaved drafts and line-ending conversion)."
msgstr "Modifier le contenu des fichiers dans l’éditeur (y compris les brouillons automatiques et la conversion des fins de ligne)."

#: assets/js/access-rules.js:142
msgid "Create files & folders"
msgstr "Créer fichiers et dossiers"

#: assets/js/access-rules.js:142
msgid "Make new empty files and folders."
msgstr "Créer de nouveaux fichiers et dossiers vides."

#: assets/js/access-rules.js:143
msgid "Upload files"
msgstr "Téléverser des fichiers"

#: assets/js/access-rules.js:143
msgid "Add files from their computer, and replace existing ones they may edit."
msgstr "Ajouter des fichiers depuis leur ordinateur et remplacer ceux qu’ils peuvent modifier."

#: assets/js/access-rules.js:144 assets/js/access-rules.js:578
msgid "Rename & move"
msgstr "Renommer et déplacer"

#: assets/js/access-rules.js:144
msgid "Rename files and folders within the folders they can access."
msgstr "Renommer fichiers et dossiers dans les dossiers auxquels ils ont accès."

#: assets/js/access-rules.js:145 assets/js/access-rules.js:578 assets/js/file-browser.js:767 assets/js/file-browser.js:1628
msgid "Delete"
msgstr "Supprimer"

#: assets/js/access-rules.js:145
msgid "Remove files and folders, including everything inside a folder."
msgstr "Supprimer fichiers et dossiers, y compris tout le contenu d’un dossier."

#: assets/js/access-rules.js:146 assets/js/access-rules.js:578 assets/js/file-browser.js:765
msgid "Change permissions"
msgstr "Modifier les droits"

#: assets/js/access-rules.js:146
msgid "Change Unix file modes (chmod). Rarely needed — keep off unless required."
msgstr "Modifier les droits Unix des fichiers (chmod). Rarement utile : laissez désactivé sauf besoin."

#: assets/js/access-rules.js:149
msgid "PHP files and any file containing PHP tags — even hidden inside an image. Anyone who can write PHP can take over the site."
msgstr "Fichiers PHP et tout fichier contenant des balises PHP, même cachées dans une image. Quiconque peut écrire du PHP peut prendre le contrôle du site."

#: assets/js/access-rules.js:150
msgid ".htaccess, .user.ini, php.ini, web.config and .env files — they change how the server runs code or hold secrets."
msgstr "Fichiers .htaccess, .user.ini, php.ini, web.config et .env : ils modifient la façon dont le serveur exécute le code ou contiennent des secrets."

#: assets/js/access-rules.js:151
msgid "Programs and scripts: binary executables, shell/Python/Perl scripts and anything starting with “#!”."
msgstr "Programmes et scripts : exécutables binaires, scripts shell/Python/Perl et tout ce qui commence par « #! »."

#: assets/js/access-rules.js:152
msgid "HTML, SVG, JavaScript and XML — they can run scripts in visitors’ browsers."
msgstr "HTML, SVG, JavaScript et XML : ils peuvent exécuter des scripts dans le navigateur des visiteurs."

#: assets/js/access-rules.js:153
msgid "ZIP, GZIP, TAR, 7-Zip, RAR and similar archives."
msgstr "ZIP, GZIP, TAR, 7-Zip, RAR et archives similaires."

#: assets/js/access-rules.js:154
msgid "JPEG, PNG, GIF, WebP, AVIF, TIFF and other images."
msgstr "JPEG, PNG, GIF, WebP, AVIF, TIFF et autres images."

#: assets/js/access-rules.js:155
msgid "MP3, MP4, WebM, WAV, OGG and other audio and video."
msgstr "MP3, MP4, WebM, WAV, OGG et autres fichiers audio et vidéo."

#: assets/js/access-rules.js:156
msgid "PDF, Word, Excel, PowerPoint, OpenDocument and RTF."
msgstr "PDF, Word, Excel, PowerPoint, OpenDocument et RTF."

#: assets/js/access-rules.js:157
msgid "SQLite databases, SQL dumps and .bak backups — they often contain passwords."
msgstr "Bases SQLite, exports SQL et sauvegardes .bak : ils contiennent souvent des mots de passe."

#: assets/js/access-rules.js:158
msgid "Anything that is not plain text and not covered above."
msgstr "Tout ce qui n’est pas du texte brut et n’est pas couvert ci-dessus."

#: assets/js/access-rules.js:161
msgid "Name contains"
msgstr "Le nom contient"

#: assets/js/access-rules.js:161
msgid "secret"
msgstr "secret"

#: assets/js/access-rules.js:161
msgid "Any file or folder whose name contains this text, in any folder. Not case-sensitive."
msgstr "Tout fichier ou dossier dont le nom contient ce texte, dans n’importe quel dossier. Insensible à la casse."

#: assets/js/access-rules.js:162
msgid "Name matches"
msgstr "Le nom correspond à"

#: assets/js/access-rules.js:162
msgid "A name pattern: * matches any characters, ? matches one. Example: *.bak or wp-config*."
msgstr "Un motif de nom : * remplace n’importe quels caractères, ? un seul. Exemple : *.bak ou wp-config*."

#: assets/js/access-rules.js:163
msgid "Exact path"
msgstr "Chemin exact"

#: assets/js/access-rules.js:163
msgid "One specific file or folder, relative to the site root."
msgstr "Un fichier ou dossier précis, relatif à la racine du site."

#: assets/js/access-rules.js:164
msgid "Folder and contents"
msgstr "Dossier et contenu"

#: assets/js/access-rules.js:164
msgid "A folder and everything inside it, relative to the site root."
msgstr "Un dossier et tout son contenu, relatif à la racine du site."

#: assets/js/access-rules.js:167
msgid "Hidden & blocked"
msgstr "Masqué et bloqué"

#: assets/js/access-rules.js:168 assets/js/access-rules.js:331 assets/js/file-browser.js:162
msgid "Read-only"
msgstr "Lecture seule"

#: assets/js/access-rules.js:223
msgid "Folders"
msgstr "Dossiers"

#: assets/js/access-rules.js:226 assets/js/file-browser.js:1949
msgid "Loading…"
msgstr "Chargement…"

#: assets/js/access-rules.js:249
msgid "No subfolders."
msgstr "Aucun sous-dossier."

#: assets/js/access-rules.js:255
msgid "Selected folder:"
msgstr "Dossier sélectionné :"

#: assets/js/access-rules.js:256
msgid "Choose a folder"
msgstr "Choisir un dossier"

#: assets/js/access-rules.js:257 assets/js/access-rules.js:771 assets/js/file-browser.js:527 assets/js/file-browser.js:552 assets/js/file-browser.js:933 assets/js/file-browser.js:1342 assets/js/file-browser.js:1481 assets/js/file-browser.js:1627 assets/js/file-browser.js:2291
msgid "Cancel"
msgstr "Annuler"

#: assets/js/access-rules.js:258
msgid "Use this folder"
msgstr "Utiliser ce dossier"

#: assets/js/access-rules.js:268
msgid "Save changes"
msgstr "Enregistrer les modifications"

#: assets/js/access-rules.js:269 assets/js/access-rules.js:772
msgid "Discard"
msgstr "Abandonner"

#: assets/js/access-rules.js:270 assets/js/file-browser.js:926
msgid "Unsaved changes"
msgstr "Modifications non enregistrées"

#: assets/js/access-rules.js:271 assets/js/access-rules.js:344
msgid "Roles"
msgstr "Rôles"

#: assets/js/access-rules.js:290
msgid "Access rules"
msgstr "Règles d’accès"

#: assets/js/access-rules.js:290 assets/js/access-rules.js:648 assets/js/file-browser.js:163 assets/js/file-browser.js:212 assets/js/file-browser.js:1915 assets/js/file-browser.js:1971
msgid "Trash"
msgstr "Corbeille"

#: assets/js/access-rules.js:293
msgid "Administrators always have full access and are not affected by these rules. Every other role has no access until you enable it."
msgstr "Les administrateurs ont toujours un accès complet et ne sont pas concernés par ces règles. Aucun autre rôle n’a accès tant que vous ne l’activez pas."

#: assets/js/access-rules.js:294
msgid "The “All roles” rules apply to every enabled role. A role’s own rules can only add restrictions on top of them."
msgstr "Les règles « Tous les rôles » s’appliquent à chaque rôle activé. Les règles propres à un rôle ne peuvent qu’ajouter des restrictions."

#: assets/js/access-rules.js:295
msgid "File editing is disabled for this site (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY), so every role is read-only whatever you allow here."
msgstr "La modification de fichiers est désactivée sur ce site (DISALLOW_FILE_EDIT / CLOVERBROWSER_READ_ONLY) : tous les rôles sont en lecture seule, quoi que vous autorisiez ici."

#: assets/js/access-rules.js:326
msgid "No access"
msgstr "Aucun accès"

#: assets/js/access-rules.js:330
msgid "Browse only"
msgstr "Consultation seule"

#: assets/js/access-rules.js:332
msgid "Full"
msgstr "Complet"

#: assets/js/access-rules.js:333
msgid "Custom"
msgstr "Personnalisé"

#: assets/js/access-rules.js:343 assets/js/access-rules.js:396 includes/class-cloverbrowser-policy.php:111
msgid "All roles"
msgstr "Tous les rôles"

#: assets/js/access-rules.js:343
msgid "Applies to every enabled role"
msgstr "S’applique à chaque rôle activé"

#. translators: %s: number of users
#: assets/js/access-rules.js:349
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s utilisateur"
msgstr[1] "%s utilisateurs"

#: assets/js/access-rules.js:351
msgid "Administrators are not listed: they always have full access."
msgstr "Les administrateurs ne sont pas listés : ils ont toujours un accès complet."

#. translators: %s: role name
#: assets/js/access-rules.js:367 includes/class-cloverbrowser-policy.php:134
msgid "%s can create or modify PHP code. Anyone who can write PHP can take over the whole site — block the “PHP code” type unless that is intended."
msgstr "%s peut créer ou modifier du code PHP. Quiconque peut écrire du PHP peut prendre le contrôle de tout le site : bloquez le type « Code PHP », sauf si c’est voulu."

#. translators: %s: role name
#: assets/js/access-rules.js:372 includes/class-cloverbrowser-policy.php:127
msgid "%s is normally given to untrusted accounts. Make sure you really want it to reach server files."
msgstr "%s est normalement attribué à des comptes non fiables. Assurez-vous de vraiment vouloir lui donner accès aux fichiers du serveur."

#: assets/js/access-rules.js:398
msgid "Baseline rules for every non-administrator role that has access. Roles can be restricted further on their own pages."
msgstr "Règles de base pour tous les rôles non administrateurs ayant accès. Chaque rôle peut être davantage restreint sur sa propre page."

#: assets/js/access-rules.js:399
msgid "Rules for this role. They add to the “All roles” rules — they can never grant more than those allow."
msgstr "Règles de ce rôle. Elles s’ajoutent à celles de « Tous les rôles » et ne peuvent jamais accorder plus que celles-ci."

#: assets/js/access-rules.js:403
msgid "Access"
msgstr "Accès"

#. translators: %s: role name
#: assets/js/access-rules.js:407
msgid "Allow %s users to use Cloverbrowser"
msgstr "Autoriser les utilisateurs du rôle %s à utiliser Cloverbrowser"

#: assets/js/access-rules.js:408
msgid "When off, users with this role do not see Cloverbrowser at all."
msgstr "Désactivé, les utilisateurs de ce rôle ne voient pas du tout Cloverbrowser."

#: assets/js/access-rules.js:412
msgid "Access is off — you can still prepare these rules; they apply once access is enabled."
msgstr "L’accès est désactivé : vous pouvez tout de même préparer ces règles ; elles s’appliqueront une fois l’accès activé."

#: assets/js/access-rules.js:417
msgid "View only"
msgstr "Lecture seule"

#: assets/js/access-rules.js:418
msgid "View & download"
msgstr "Lecture et téléchargement"

#: assets/js/access-rules.js:419
msgid "Edit files"
msgstr "Modifier les fichiers"

#: assets/js/access-rules.js:420
msgid "Everything"
msgstr "Tout"

#: assets/js/access-rules.js:422
msgid "Presets"
msgstr "Préréglages"

#: assets/js/access-rules.js:423
msgid "Presets:"
msgstr "Préréglages :"

#: assets/js/access-rules.js:432
msgid "Not allowed for any role (All roles)"
msgstr "Interdit pour tous les rôles (Tous les rôles)"

#: assets/js/access-rules.js:434
msgid "What they can do"
msgstr "Ce qu’ils peuvent faire"

#: assets/js/access-rules.js:442 assets/js/access-rules.js:443
msgid "No folder limit: the whole site folder is reachable (minus protected items)."
msgstr "Aucune limite de dossier : tout le dossier du site est accessible (hors éléments protégés)."

#: assets/js/access-rules.js:443
msgid "No extra limit: the “All roles” folders apply."
msgstr "Aucune limite supplémentaire : les dossiers de « Tous les rôles » s’appliquent."

#: assets/js/access-rules.js:447 assets/js/access-rules.js:529 assets/js/file-browser.js:2292
msgid "Remove"
msgstr "Retirer"

#. translators: %s: folder path
#: assets/js/access-rules.js:449
msgid "Remove %s"
msgstr "Retirer %s"

#: assets/js/access-rules.js:452
msgid "Folder path"
msgstr "Chemin du dossier"

#: assets/js/access-rules.js:455
msgid "Enter a folder path relative to the site root."
msgstr "Saisissez un chemin de dossier relatif à la racine du site."

#: assets/js/access-rules.js:462
msgid "Where they can go"
msgstr "Où ils peuvent aller"

#: assets/js/access-rules.js:463
msgid "Limit every role to these folders and everything inside them. Leave empty for no limit."
msgstr "Limiter tous les rôles à ces dossiers et à leur contenu. Laissez vide pour ne fixer aucune limite."

#: assets/js/access-rules.js:464
msgid "Limit this role to these folders. When “All roles” also has folders, only the overlap is reachable."
msgstr "Limiter ce rôle à ces dossiers. Si « Tous les rôles » a aussi des dossiers, seule la partie commune est accessible."

#: assets/js/access-rules.js:467 assets/js/access-rules.js:615 assets/js/access-rules.js:615
msgid "Choose folder…"
msgstr "Choisir un dossier…"

#: assets/js/access-rules.js:469
msgid "Add"
msgstr "Ajouter"

#: assets/js/access-rules.js:482
msgid "Blocked for all roles"
msgstr "Bloqué pour tous les rôles"

#: assets/js/access-rules.js:485
msgid "Blocked file types"
msgstr "Types de fichiers bloqués"

#: assets/js/access-rules.js:486
msgid "Blocked files cannot be opened, downloaded, edited, uploaded or created. Types are recognised by their content (file headers and embedded code), not just by the name."
msgstr "Les fichiers bloqués ne peuvent être ni ouverts, ni téléchargés, ni modifiés, ni téléversés, ni créés. Les types sont reconnus d’après leur contenu (en-têtes et code intégré), pas seulement d’après le nom."

#: assets/js/access-rules.js:495 assets/js/access-rules.js:523
msgid "Match"
msgstr "Correspondance"

#: assets/js/access-rules.js:496 assets/js/access-rules.js:511
msgid "Pattern or path"
msgstr "Motif ou chemin"

#: assets/js/access-rules.js:497 assets/js/access-rules.js:525
msgid "Effect"
msgstr "Effet"

#: assets/js/access-rules.js:502
msgid "Built in: always protected from non-administrators."
msgstr "Intégré : toujours protégé contre les non-administrateurs."

#: assets/js/access-rules.js:502
msgid "Always"
msgstr "Toujours"

#. translators: %s: number of rules
#: assets/js/access-rules.js:506
msgid "Plus %s rule from “All roles” and the built-in protections."
msgid_plural "Plus %s rules from “All roles” and the built-in protections."
msgstr[0] "Plus %s règle de « Tous les rôles » et les protections intégrées."
msgstr[1] "Plus %s règles de « Tous les rôles » et les protections intégrées."

#: assets/js/access-rules.js:507
msgid "Plus the built-in protections."
msgstr "Plus les protections intégrées."

#: assets/js/access-rules.js:516
msgid "Required."
msgstr "Obligatoire."

#: assets/js/access-rules.js:517
msgid "Name rules match a single name — use “Exact path” or “Folder and contents” for paths."
msgstr "Les règles de nom portent sur un seul nom : utilisez « Chemin exact » ou « Dossier et contenu » pour les chemins."

#: assets/js/access-rules.js:529
msgid "Remove rule"
msgstr "Retirer la règle"

#: assets/js/access-rules.js:531
msgid "No rules yet."
msgstr "Aucune règle pour l’instant."

#: assets/js/access-rules.js:538
msgid "Add rule"
msgstr "Ajouter une règle"

#: assets/js/access-rules.js:541
msgid "Protected files & folders"
msgstr "Fichiers et dossiers protégés"

#: assets/js/access-rules.js:542
msgid "“Hidden & blocked” items are not listed and cannot be opened. “Read-only” items are visible but cannot be changed. A rule that matches a folder also covers everything inside it."
msgstr "Les éléments « Masqué et bloqué » ne sont pas listés et ne peuvent pas être ouverts. Les éléments « Lecture seule » sont visibles mais non modifiables. Une règle qui vise un dossier couvre aussi tout son contenu."

#: assets/js/access-rules.js:551
msgid "Unit"
msgstr "Unité"

#: assets/js/access-rules.js:561
msgid "Size limits"
msgstr "Limites de taille"

#: assets/js/access-rules.js:562
msgid "Leave empty or 0 for no limit (the server’s own upload limit still applies)."
msgstr "Laissez vide ou à 0 pour aucune limite (la limite de téléversement du serveur s’applique toujours)."

#: assets/js/access-rules.js:563
msgid "Leave empty or 0 for no extra limit. When both are set, the smaller one applies."
msgstr "Laissez vide ou à 0 pour aucune limite supplémentaire. Si les deux sont définies, la plus petite s’applique."

#: assets/js/access-rules.js:564
msgid "Largest upload"
msgstr "Téléversement maximal"

#: assets/js/access-rules.js:564
msgid "Maximum size of each uploaded file."
msgstr "Taille maximale de chaque fichier téléversé."

#: assets/js/access-rules.js:565
msgid "Largest growth per save"
msgstr "Croissance maximale par enregistrement"

#: assets/js/access-rules.js:565
msgid "How much bigger a file may become in one editor save."
msgstr "De combien un fichier peut grossir en un seul enregistrement dans l’éditeur."

#: assets/js/access-rules.js:576
msgid "Browse folder"
msgstr "Parcourir le dossier"

#: assets/js/access-rules.js:576
msgid "Open"
msgstr "Ouvrir"

#: assets/js/access-rules.js:576 assets/js/file-browser.js:763
msgid "Download"
msgstr "Télécharger"

#: assets/js/access-rules.js:577
msgid "Edit & save"
msgstr "Modifier et enregistrer"

#: assets/js/access-rules.js:577
msgid "Create inside"
msgstr "Créer dedans"

#: assets/js/access-rules.js:577
msgid "Upload into"
msgstr "Téléverser dedans"

#: assets/js/access-rules.js:581
msgid "Role"
msgstr "Rôle"

#: assets/js/access-rules.js:582
msgid "Path to test"
msgstr "Chemin à tester"

#: assets/js/access-rules.js:587
msgid "Checking…"
msgstr "Vérification…"

#: assets/js/access-rules.js:592
msgid "This role has no access at all (access is switched off)."
msgstr "Ce rôle n’a aucun accès (l’accès est désactivé)."

#: assets/js/access-rules.js:595
msgid "file"
msgstr "fichier"

#: assets/js/access-rules.js:595
msgid "folder"
msgstr "dossier"

#. translators: %s: detected file types
#: assets/js/access-rules.js:598
msgid "detected as: %s"
msgstr "détecté comme : %s"

#: assets/js/access-rules.js:602
msgid "Allowed"
msgstr "Autorisé"

#: assets/js/access-rules.js:611
msgid "Test access"
msgstr "Tester l’accès"

#: assets/js/access-rules.js:612
msgid "Check what a role could do with a file or folder — using the rules on this screen, even before you save them."
msgstr "Vérifiez ce qu’un rôle pourrait faire d’un fichier ou d’un dossier, avec les règles de cet écran, avant même de les enregistrer."

#: assets/js/access-rules.js:616
msgid "Test"
msgstr "Tester"

#: assets/js/access-rules.js:631
msgid "Enter a number of days between 1 and 3650."
msgstr "Saisissez un nombre de jours compris entre 1 et 3650."

#: assets/js/access-rules.js:638
msgid "days"
msgstr "jours"

#: assets/js/access-rules.js:649
msgid "Deleted files and folders can be kept for a while so they can be restored. There are two levels, and each can be switched on separately."
msgstr "Les fichiers et dossiers supprimés peuvent être conservés un certain temps afin de pouvoir être restaurés. Il existe deux niveaux, activables séparément."

#: assets/js/access-rules.js:653
msgid "Personal trash"
msgstr "Corbeille personnelle"

#: assets/js/access-rules.js:655
msgid "Give every user their own trash"
msgstr "Donner à chaque utilisateur sa propre corbeille"

#: assets/js/access-rules.js:656
msgid "Each user’s deletions go to their own Trash, where they can restore them, remove them or empty it. They only ever see their own items."
msgstr "Les éléments supprimés par chaque utilisateur vont dans sa propre Corbeille, où il peut les restaurer, les retirer ou la vider. Il ne voit jamais que ses propres éléments."

#: assets/js/access-rules.js:657
msgid "Keep items in a user’s trash for"
msgstr "Conserver les éléments dans la corbeille d’un utilisateur pendant"

#: assets/js/access-rules.js:659 assets/js/file-browser.js:214 assets/js/file-browser.js:1971
msgid "Site trash"
msgstr "Corbeille du site"

#: assets/js/access-rules.js:661
msgid "Keep every deletion in the site trash"
msgstr "Conserver chaque suppression dans la corbeille du site"

#: assets/js/access-rules.js:662
msgid "A safety net for administrators: everything any user deletes is kept here, even after they empty their own trash. Only administrators can see it, restore from it or empty it."
msgstr "Un filet de sécurité pour les administrateurs : tout ce qu’un utilisateur supprime est conservé ici, même après qu’il a vidé sa propre corbeille. Seuls les administrateurs peuvent la voir, en restaurer des éléments ou la vider."

#: assets/js/access-rules.js:663
msgid "Keep items in the site trash for"
msgstr "Conserver les éléments dans la corbeille du site pendant"

#: assets/js/access-rules.js:669
msgid "Recommended"
