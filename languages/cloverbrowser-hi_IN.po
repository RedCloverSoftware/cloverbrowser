msgstr "संपादित करें और सहेजें"

#: assets/js/access-rules.js:577
msgid "Create inside"
msgstr "अंदर बनाएँ"

#: assets/js/access-rules.js:577
msgid "Upload into"
msgstr "इसमें अपलोड करें"

#: assets/js/access-rules.js:581
msgid "Role"
msgstr "भूमिका"

#: assets/js/access-rules.js:582
msgid "Path to test"
msgstr "जाँचने के लिए पथ"

