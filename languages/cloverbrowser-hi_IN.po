msgstr "अमान्य पथ खंड।"

#: includes/class-cloverbrowser-sandbox.php:227 includes/class-cloverbrowser-trash.php:668 includes/class-cloverbrowser-trash.php:683
msgid "Path resolves outside the sandbox."
msgstr "पथ सैंडबॉक्स के बाहर जाता है।"

#: includes/class-cloverbrowser-sandbox.php:241
msgid "Invalid name."
msgstr "अमान्य नाम।"

#. translators: %s: path
#: includes/class-cloverbrowser-sandbox.php:248
msgid "Parent folder not found: %s"
msgstr "मूल फ़ोल्डर नहीं मिला: %s"

#: includes/class-cloverbrowser-sandbox.php:253
msgid "Parent folder resolves outside the sandbox."
msgstr "मूल फ़ोल्डर सैंडबॉक्स के बाहर जाता है।"

#: includes/class-cloverbrowser-sandbox.php:276
msgid "This operation is not allowed on the sandbox root."
msgstr "सैंडबॉक्स रूट पर यह कार्रवाई करने की अनुमति नहीं है।"

#. translators: %s: path
#: includes/class-cloverbrowser-sandbox.php:285
msgid "Path not found: %s"
msgstr "पथ नहीं मिला: %s"

#: includes/class-cloverbrowser-trash.php:166
msgid "The trash folder could not be created. Check that the uploads folder is writable by PHP."
msgstr "ट्रैश फ़ोल्डर नहीं बनाया जा सका। जाँचें कि PHP अपलोड फ़ोल्डर में लिख सकता है।"

#: includes/class-cloverbrowser-trash.php:421
msgid "The trash is turned off."
msgstr "ट्रैश बंद है।"

#: includes/class-cloverbrowser-trash.php:453
msgid "This item could not be moved to the trash (it may be on another disk, or permissions do not allow it). Nothing was deleted."
msgstr "यह आइटम ट्रैश में नहीं ले जाया जा सका (हो सकता है यह किसी दूसरी डिस्क पर हो, या अनुमतियाँ इसकी इजाज़त न देती हों)। कुछ भी हटाया नहीं गया।"

#: includes/class-cloverbrowser-trash.php:464
msgid "The trash could not record this item, so it was left in place."
msgstr "ट्रैश इस आइटम को दर्ज नहीं कर सका, इसलिए इसे अपनी जगह पर छोड़ दिया गया।"

#: includes/class-cloverbrowser-trash.php:574 includes/class-cloverbrowser-trash.php:611 includes/class-cloverbrowser-trash.php:737 includes/class-cloverbrowser-trash.php:785
msgid "This item is no longer in the trash."
msgstr "यह आइटम अब ट्रैश में नहीं है।"

#: includes/class-cloverbrowser-trash.php:621
msgid "The stored copy of this item is missing."
msgstr "इस आइटम की संग्रहीत प्रति मौजूद नहीं है।"

#. translators: %s: path
#: includes/class-cloverbrowser-trash.php:646
msgid "Cannot restore: %s is no longer a folder."
msgstr "वापस नहीं लाया जा सकता: %s अब फ़ोल्डर नहीं है।"

#: includes/class-cloverbrowser-trash.php:663
msgid "Could not find a free name to restore this item under."
msgstr "इस आइटम को वापस लाने के लिए कोई खाली नाम नहीं मिला।"

#. translators: %s: folder path
#: includes/class-cloverbrowser-trash.php:678
msgid "Could not recreate the folder %s."
msgstr "फ़ोल्डर %s दोबारा नहीं बनाया जा सका।"

#: includes/class-cloverbrowser-trash.php:686
msgid "Restore failed (check permissions on the original folder)."
msgstr "वापस लाना विफल रहा (मूल फ़ोल्डर की अनुमतियाँ जाँचें)।"

#: includes/class-cloverbrowser-trash.php:794
msgid "Some of this item could not be deleted (check permissions)."
msgstr "इस आइटम का कुछ हिस्सा हटाया नहीं जा सका (अनुमतियाँ जाँचें)।"

#. translators: Plugin header
#: cloverbrowser.php
msgid "Server file browser & editor for WordPress admins, sandboxed to this site's vhost root, with per-role access rules and a two-level trash. No public exposure."
msgstr "WordPress व्यवस्थापकों के लिए सर्वर फ़ाइल ब्राउज़र और संपादक, जो इस साइट के वर्चुअल होस्ट रूट तक सीमित है और जिसमें भूमिका-आधारित पहुँच नियम और दो-स्तरीय ट्रैश हैं। कोई सार्वजनिक पहुँच नहीं।"
